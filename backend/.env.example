# اطلاعات دیتابیس MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vpn_panel
DB_USER=vpn_panel
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# کلید امنیتی JWT (با اسکریپت نصب به‌صورت رندوم ساخته می‌شود)
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# توکن داخلی برای ارتباط اسکریپت‌های ppp/openvpn با API (فقط روی لوکال‌هاست)
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# کلید مستقل برای رمزگذاری اسرار دیتابیس و رمز SSH نودها.
# دقیقاً ۳۲ بایت باشد؛ نصب‌کننده به‌صورت ۶۴ کاراکتر hex تولید می‌کند.
DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_DATA_KEY

BACKUP_MAX_COMPRESSED_BYTES=134217728
BACKUP_MAX_DECOMPRESSED_BYTES=805306368

# پورت داخلی و فقط لوکال FastAPI؛ نصب‌کننده در صورت تداخل پورت عمومی آن را
# به بازه 18000-18099 منتقل می‌کند.
BACKEND_PORT=8000

# آدرس عمومی سرور (برای نمایش در پنل و ساخت کانفیگ کلاینت‌ها)
PUBLIC_SERVER_IP=YOUR_SERVER_IP

# مقدار PSK اشتراکی برای L2TP/IPsec
IPSEC_PSK=CHANGE_ME_PSK

# مسیر فایل‌های سیستمی
CHAP_SECRETS_PATH=/etc/ppp/chap-secrets
OPENVPN_STATUS_LOG=/etc/openvpn/server/openvpn-status.log
OPENVPN_CCD_DIR=/etc/openvpn/server/ccd
OPENVPN_CA_PATH=/etc/openvpn/server/ca.crt
OPENVPN_TA_PATH=/etc/openvpn/server/ta.key

# چرخه بررسی وضعیت کاربران آنلاین/مصرف (ثانیه)
MONITOR_INTERVAL_SECONDS=2
PROTOCOL_WATCHDOG_INTERVAL_SECONDS=30

# سرور لایسنس مرکزی و کلید API را فقط در محیط نصب/فایل امن سرور قرار بده؛
# هیچ کلید واقعی نباید در سورس، ZIP انتشار یا مستندات commit شود.
LICENSE_SERVER_URL=https://license.example.com
LICENSE_API_KEY=CHANGE_ME_LICENSE_API_KEY
LICENSE_CHECK_INTERVAL_SECONDS=3
LICENSE_GRACE_PERIOD_HOURS=72
LICENSE_FAIL_CLOSED=true
# فقط برای توسعه محلی؛ روی سرور مشتری همیشه false بماند.
LICENSE_ALLOW_UNLICENSED_DEVELOPMENT=false

# برای نصب same-origin خالی بماند. در حالت cross-origin فقط originهای دقیق HTTPS.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true

# کلید میزبان SSH در اولین اتصال ذخیره و هر تغییر بعدی رد می‌شود.
SSH_KNOWN_HOSTS_PATH=/var/lib/vpn-panel/ssh_known_hosts
SSH_HOST_KEY_POLICY=tofu

# VMess/VLESS live presence: every 5 seconds, offline after 2 consecutive misses.
XRAY_ACTIVITY_GRACE_SECONDS=5
XRAY_PRESENCE_FAILURE_LIMIT=2
# Best-effort same-NAT separation by current public-IP + TCP source-port.
XRAY_STRICT_SAME_NAT=0  # deprecated; source ports are streams, not devices
